{
  "description": "Injects the orchestration rules at session start",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestration.md\""
          }
        ]
      }
    ]
  }
}
